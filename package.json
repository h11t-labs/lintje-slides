{
  "name": "@lintje/slides",
  "version": "0.2.0",
  "type": "module",
  "description": "Lintje slides: presentations in HTML in the Rijkshuisstijl, with thirty layouts, a check and a PDF",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h11t-labs/lintje-slides.git"
  },
  "bin": {
    "lintje-slides": "bin/lintje-slides.mjs"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "examples",
    "skills"
  ],
  "exports": {
    "./slides.css": "./src/slides.css",
    "./slides.js": "./src/slides.js",
    "./layouts.js": "./src/layouts.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node bin/lintje-slides.mjs serve",
    "check": "node bin/lintje-slides.mjs check",
    "test": "node --test test/*.test.mjs",
    "pdf": "node bin/lintje-slides.mjs pdf",
    "catalog": "node scripts/catalog.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "lintje": "0.13.2",
    "playwright": "1.64.1"
  }
}
